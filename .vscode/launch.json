{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start AcxiomCRM Enterprise (Server)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/src/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000",
        "NODE_ENV": "development"
      },
      "serverReadyAction": {
        "pattern": "Server running on port ([0-9]+)",
        "uriFormat": "http://localhost:%s/login",
        "action": "openExternally"
      }
    }
  ]
}
