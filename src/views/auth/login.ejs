<div class="auth-card-container">
  <div class="card auth-card shadow-lg border-0">
    <div class="card-body p-4 p-sm-5">
      
      <!-- Brand Header -->
      <div class="text-center mb-4">
        <div class="auth-brand-logo mb-3">
          <i class="bi bi-shield-check fs-2 text-white"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1 tracking-tight">AcxiomCRM</h3>
        <p class="text-muted text-sm mb-0">Enterprise Customer & Sales Management</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2 px-3 text-sm d-flex align-items-center mb-3" role="alert">
          <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success py-2 px-3 text-sm d-flex align-items-center mb-3" role="alert">
          <i class="bi bi-check-circle-fill me-2 fs-5"></i>
          <div><%= message %></div>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" data-validate="true">
        <div class="mb-3">
          <label for="emailInput" class="form-label fw-semibold text-secondary text-xs text-uppercase">Corporate Email</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" id="emailInput" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" placeholder="name@company.com" required autofocus>
          </div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="passwordInput" class="form-label fw-semibold text-secondary text-xs text-uppercase mb-0">Password</label>
          </div>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" id="passwordInput" name="password" placeholder="••••••••" required>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="form-check text-xs">
            <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" checked>
            <label class="form-check-label text-muted" for="rememberMe">Remember this device</label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3 auth-submit-btn">
          <span>Sign In to Workplace</span>
          <i class="bi bi-arrow-right ms-2"></i>
        </button>
      </form>

      <div class="text-center pt-2 border-top">
        <span class="text-muted text-xs">Need account access? </span>
        <a href="/register" class="fw-semibold text-primary text-decoration-none text-xs">Register Corporate User</a>
      </div>

    </div>
  </div>
</div>
