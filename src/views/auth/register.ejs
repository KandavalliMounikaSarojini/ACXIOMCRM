<div class="auth-card-container" style="max-width: 480px;">
  <div class="card auth-card shadow-lg border-0">
    <div class="card-body p-4 p-sm-5">
      
      <div class="text-center mb-4">
        <div class="auth-brand-logo mb-3">
          <i class="bi bi-person-badge fs-2 text-white"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1 tracking-tight">User Registration</h3>
        <p class="text-muted text-sm mb-0">Join the AcxiomCRM Organization</p>
      </div>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="alert alert-danger py-2 px-3 text-sm mb-3" role="alert">
          <ul class="mb-0 ps-3">
            <% errors.forEach(err => { %>
              <li><%= err.message %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="POST" data-validate="true">
        <div class="mb-3">
          <label for="nameInput" class="form-label fw-semibold text-secondary text-xs text-uppercase">Full Name <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" id="nameInput" name="name" value="<%= typeof formData !== 'undefined' ? formData.name : '' %>" placeholder="e.g. Vikram Sharma" required autofocus>
          </div>
        </div>

        <div class="mb-3">
          <label for="emailInput" class="form-label fw-semibold text-secondary text-xs text-uppercase">Work Email <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" id="emailInput" name="email" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" placeholder="name@company.com" required>
          </div>
        </div>

        <div class="mb-3">
          <label for="passwordInput" class="form-label fw-semibold text-secondary text-xs text-uppercase">Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" id="passwordInput" name="password" placeholder="Min. 8 characters" required>
          </div>
          <div class="form-text text-xs text-muted mt-1">
            Must contain at least 8 characters, 1 uppercase letter, 1 lowercase letter, and 1 number.
          </div>
        </div>

        <div class="mb-4">
          <label for="confirmPasswordInput" class="form-label fw-semibold text-secondary text-xs text-uppercase">Confirm Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" id="confirmPasswordInput" name="confirmPassword" placeholder="Confirm password" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3 auth-submit-btn">
          <span>Create Account</span>
          <i class="bi bi-arrow-right ms-2"></i>
        </button>
      </form>

      <div class="text-center pt-2 border-top">
        <span class="text-muted text-xs">Already have an account? </span>
        <a href="/login" class="fw-semibold text-primary text-decoration-none text-xs">Sign In</a>
      </div>

    </div>
  </div>
</div>
