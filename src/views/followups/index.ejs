<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1">Follow-Up Management</h3>
      <p class="text-muted mb-0">Scheduled touchpoints, calls, and meetings &bull; <%= total %> total activities</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/followups/create" class="btn btn-crm-primary">
        <i class="bi bi-plus-lg"></i> Schedule Follow-Up
      </a>
    </div>
  </div>

  <!-- Time Filter Tabs & Filters -->
  <div class="crm-card mb-4">
    <div class="crm-card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        
        <div class="btn-group btn-group-sm" role="group">
          <a href="/followups" class="btn <%= !filters.timeFilter ? 'btn-primary' : 'btn-outline-secondary' %>">All Follow-Ups</a>
          <a href="/followups?timeFilter=today" class="btn <%= filters.timeFilter === 'today' ? 'btn-primary' : 'btn-outline-secondary' %>">Today</a>
          <a href="/followups?timeFilter=upcoming" class="btn <%= filters.timeFilter === 'upcoming' ? 'btn-primary' : 'btn-outline-secondary' %>">Upcoming</a>
          <a href="/followups?timeFilter=overdue" class="btn <%= filters.timeFilter === 'overdue' ? 'btn-danger' : 'btn-outline-danger' %>">
            <i class="bi bi-exclamation-circle me-1"></i> Overdue
          </a>
        </div>

        <form action="/followups" method="GET" class="d-flex align-items-center gap-2">
          <% if (filters.timeFilter) { %><input type="hidden" name="timeFilter" value="<%= filters.timeFilter %>"><% } %>
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Statuses --</option>
            <option value="Planned" <%= filters.status === 'Planned' ? 'selected' : '' %>>Planned</option>
            <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            <option value="Missed" <%= filters.status === 'Missed' ? 'selected' : '' %>>Missed</option>
            <option value="Cancelled" <%= filters.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
          <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Types --</option>
            <option value="Call" <%= filters.type === 'Call' ? 'selected' : '' %>>Call</option>
            <option value="Meeting" <%= filters.type === 'Meeting' ? 'selected' : '' %>>Meeting</option>
            <option value="Video Demo" <%= filters.type === 'Video Demo' ? 'selected' : '' %>>Video Demo</option>
            <option value="Email" <%= filters.type === 'Email' ? 'selected' : '' %>>Email</option>
            <option value="Quote Review" <%= filters.type === 'Quote Review' ? 'selected' : '' %>>Quote Review</option>
          </select>
        </form>

      </div>
    </div>
  </div>

  <!-- Follow-ups Table -->
  <div class="crm-card">
    <div class="crm-card-body p-0">
      <div class="table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Follow-Up Subject</th>
              <th>Type</th>
              <th>Scheduled Date & Time</th>
              <th>Associated Account</th>
              <th>Status</th>
              <th>Assigned Executive</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (followUps && followUps.length > 0) { %>
              <% followUps.forEach(f => { %>
                <tr class="<%= f.isOverdue ? 'table-danger' : '' %>">
                  <td>
                    <div class="fw-bold text-dark"><%= f.Subject %></div>
                    <% if (f.Remarks) { %>
                      <div class="text-xs text-muted"><%= f.Remarks %></div>
                    <% } %>
                    <% if (f.isOverdue) { %>
                      <span class="badge bg-danger text-white text-xs mt-1"><i class="bi bi-clock-history me-1"></i> OVERDUE</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= f.FollowUpType %></span>
                  </td>
                  <td class="text-sm">
                    <div class="fw-semibold"><%= new Date(f.FollowUpDate).toLocaleDateString() %></div>
                    <div class="text-xs text-muted"><%= new Date(f.FollowUpDate).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) %></div>
                  </td>
                  <td class="text-sm">
                    <% if (f.CustomerId) { %>
                      <a href="/customers/<%= f.CustomerId %>" class="text-decoration-none fw-semibold">
                        <i class="bi bi-building me-1"></i><%= f.CustomerName %>
                      </a>
                    <% } else if (f.LeadId) { %>
                      <a href="/leads/<%= f.LeadId %>" class="text-decoration-none fw-semibold">
                        <i class="bi bi-funnel me-1"></i><%= f.LeadName %>
                      </a>
                    <% } else { %>
                      <span class="text-muted">General</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge-status status-<%= f.Status.toLowerCase() %>">
                      <%= f.Status %>
                    </span>
                  </td>
                  <td class="text-sm">
                    <%= f.AssignedToName %>
                  </td>
                  <td class="text-end">
                    <% if (f.Status === 'Planned') { %>
                      <button type="button" class="btn btn-sm btn-success py-1 px-2 text-xs fw-semibold" onclick="completeFollowUp(<%= f.FollowUpId %>)">
                        <i class="bi bi-check-lg"></i> Complete
                      </button>
                    <% } else { %>
                      <span class="text-xs text-muted">Finished</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-5">
                  <i class="bi bi-calendar-check fs-1 d-block mb-2 text-secondary"></i>
                  No follow-ups found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="crm-card-header bg-light py-2">
      <div class="text-xs text-muted">Page <%= currentPage %> of <%= totalPages %> (<%= total %> total records)</div>
      <nav aria-label="Table pagination">
        <ul class="pagination pagination-sm mb-0">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/followups?page=<%= i %>&timeFilter=<%= filters.timeFilter %>&status=<%= filters.status %>">
                <%= i %>
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
    <% } %>
  </div>
</div>
