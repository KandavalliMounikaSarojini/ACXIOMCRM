<div class="container-fluid px-0" style="max-width: 800px;">
  
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <a href="/opportunities/<%= opportunity.OpportunityId %>" class="text-decoration-none text-muted text-sm">&larr; Back to Deal</a>
      <h3 class="fw-bold mt-1 mb-0">Edit Opportunity: <%= opportunity.OpportunityName %></h3>
    </div>
  </div>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger py-2 mb-4" role="alert">
      <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please correct the following errors:</div>
      <ul class="mb-0 ps-3">
        <% errors.forEach(err => { %>
          <li><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="crm-card">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-pencil-square text-primary"></i> Edit Opportunity Parameters</span>
    </div>
    <div class="crm-card-body p-4">
      <form action="/opportunities/<%= opportunity.OpportunityId %>/edit" method="POST" data-validate="true">
        
        <div class="mb-3">
          <label for="opportunityName" class="form-label">Opportunity / Deal Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="opportunityName" name="OpportunityName" value="<%= opportunity.OpportunityName %>" required autofocus>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="customerId" class="form-label">Customer Account <span class="text-danger">*</span></label>
            <select class="form-select" id="customerId" name="CustomerId" required>
              <% customers.forEach(c => { %>
                <option value="<%= c.CustomerId %>" <%= opportunity.CustomerId == c.CustomerId ? 'selected' : '' %>>
                  <%= c.CustomerName %> (<%= c.CompanyName || c.CustomerCode %>)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label for="amount" class="form-label">Deal Amount ($) <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="number" class="form-control" id="amount" name="Amount" value="<%= opportunity.Amount %>" min="1" step="100" required>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="stage" class="form-label">Pipeline Stage <span class="text-danger">*</span></label>
            <select class="form-select" id="stage" name="Stage" required>
              <option value="Qualification" <%= opportunity.Stage === 'Qualification' ? 'selected' : '' %>>Qualification</option>
              <option value="Proposal" <%= opportunity.Stage === 'Proposal' ? 'selected' : '' %>>Proposal</option>
              <option value="Negotiation" <%= opportunity.Stage === 'Negotiation' ? 'selected' : '' %>>Negotiation</option>
              <option value="Won" <%= opportunity.Stage === 'Won' ? 'selected' : '' %>>Closed Won</option>
              <option value="Lost" <%= opportunity.Stage === 'Lost' ? 'selected' : '' %>>Closed Lost</option>
            </select>
          </div>
          <div class="col-md-4">
            <label for="probability" class="form-label">Win Probability (%) <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="number" class="form-control" id="probability" name="Probability" value="<%= opportunity.Probability %>" min="0" max="100" required>
              <span class="input-group-text">%</span>
            </div>
          </div>
          <div class="col-md-4">
            <label for="expectedCloseDate" class="form-label">Expected Close Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="expectedCloseDate" name="ExpectedCloseDate" value="<%= opportunity.ExpectedCloseDate %>" required>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="assignedTo" class="form-label">Opportunity Owner</label>
            <select class="form-select" id="assignedTo" name="AssignedTo">
              <% salesExecutives.forEach(exec => { %>
                <option value="<%= exec.UserId %>" <%= opportunity.AssignedTo == exec.UserId ? 'selected' : '' %>>
                  <%= exec.Name %> (<%= exec.RoleName %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="mb-4">
          <label for="notes" class="form-label">Deal Scope & Notes</label>
          <textarea class="form-control" id="notes" name="Notes" rows="3"><%= opportunity.Notes || '' %></textarea>
        </div>

        <div class="d-flex align-items-center justify-content-between border-top pt-3">
          <button type="button" class="btn btn-outline-danger btn-sm" onclick="document.getElementById('deleteOppForm').submit()">
            <i class="bi bi-trash"></i> Delete Opportunity
          </button>
          <div class="d-flex gap-2">
            <a href="/opportunities/<%= opportunity.OpportunityId %>" class="btn btn-crm-outline">Cancel</a>
            <button type="submit" class="btn btn-crm-primary px-4">
              <i class="bi bi-check2"></i> Save Changes
            </button>
          </div>
        </div>
      </form>

      <form id="deleteOppForm" action="/opportunities/<%= opportunity.OpportunityId %>/delete" method="POST" class="delete-confirm-form d-none" data-confirm="Are you sure you want to permanently delete this opportunity?">
      </form>
    </div>
  </div>
</div>
