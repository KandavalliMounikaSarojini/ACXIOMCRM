<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <a href="/opportunities" class="text-decoration-none text-muted text-sm">&larr; Back to Opportunities</a>
      <div class="d-flex align-items-center gap-2 mt-1">
        <h3 class="fw-bold mb-0"><%= opportunity.OpportunityName %></h3>
        <span class="badge-status status-<%= opportunity.Stage.toLowerCase() %>"><%= opportunity.Stage %></span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/followups/create?opportunityId=<%= opportunity.OpportunityId %>" class="btn btn-crm-outline">
        <i class="bi bi-calendar-plus"></i> Schedule Follow-Up
      </a>
      <a href="/activities/create?opportunityId=<%= opportunity.OpportunityId %>" class="btn btn-crm-outline">
        <i class="bi bi-telephone-plus"></i> Log Activity
      </a>
      <a href="/opportunities/<%= opportunity.OpportunityId %>/edit" class="btn btn-crm-primary">
        <i class="bi bi-pencil"></i> Edit Deal
      </a>
    </div>
  </div>

  <div class="row g-4">
    <!-- Deal Value & Stage Pipeline -->
    <div class="col-lg-8">
      <div class="crm-card">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-briefcase-fill text-primary"></i> Deal Financial Valuation</span>
        </div>
        <div class="crm-card-body">
          <div class="row g-4 mb-4">
            <div class="col-sm-4">
              <div class="text-xs text-muted fw-bold text-uppercase">Contract Value</div>
              <div class="fs-3 fw-bold text-dark">$<%= Number(opportunity.Amount).toLocaleString() %></div>
            </div>
            <div class="col-sm-4">
              <div class="text-xs text-muted fw-bold text-uppercase">Win Probability</div>
              <div class="fs-3 fw-bold text-primary"><%= opportunity.Probability %>%</div>
            </div>
            <div class="col-sm-4">
              <div class="text-xs text-muted fw-bold text-uppercase">Weighted Forecast</div>
              <div class="fs-3 fw-bold text-success">$<%= Number(opportunity.WeightedAmount || (opportunity.Amount * opportunity.Probability / 100)).toLocaleString(undefined, {maximumFractionDigits: 0}) %></div>
            </div>
          </div>

          <!-- Stage Progress Bar -->
          <div class="mb-4">
            <div class="d-flex justify-content-between text-xs text-muted fw-bold mb-1">
              <span>Qualification</span>
              <span>Proposal</span>
              <span>Negotiation</span>
              <span>Closed Won</span>
            </div>
            <% 
              let progressPercent = 25;
              if (opportunity.Stage === 'Proposal') progressPercent = 50;
              if (opportunity.Stage === 'Negotiation') progressPercent = 75;
              if (opportunity.Stage === 'Won') progressPercent = 100;
              if (opportunity.Stage === 'Lost') progressPercent = 100;
            %>
            <div class="progress" style="height: 10px;">
              <div class="progress-bar <%= opportunity.Stage === 'Lost' ? 'bg-danger' : (opportunity.Stage === 'Won' ? 'bg-success' : 'bg-primary') %>" role="progressbar" style="width: <%= progressPercent %>%;"></div>
            </div>
          </div>

          <!-- Quick Stage Switch Buttons -->
          <div class="p-3 bg-light rounded-3 border">
            <div class="text-xs text-muted fw-bold text-uppercase mb-2">Advance Stage:</div>
            <div class="d-flex flex-wrap gap-2">
              <button class="btn btn-sm btn-outline-primary <%= opportunity.Stage === 'Qualification' ? 'active' : '' %>" onclick="updateOpportunityStage(<%= opportunity.OpportunityId %>, 'Qualification')">1. Qualification</button>
              <button class="btn btn-sm btn-outline-warning <%= opportunity.Stage === 'Proposal' ? 'active' : '' %>" onclick="updateOpportunityStage(<%= opportunity.OpportunityId %>, 'Proposal')">2. Proposal</button>
              <button class="btn btn-sm btn-outline-info <%= opportunity.Stage === 'Negotiation' ? 'active' : '' %>" onclick="updateOpportunityStage(<%= opportunity.OpportunityId %>, 'Negotiation')">3. Negotiation</button>
              <button class="btn btn-sm btn-outline-success <%= opportunity.Stage === 'Won' ? 'active' : '' %>" onclick="updateOpportunityStage(<%= opportunity.OpportunityId %>, 'Won')">🏆 Won</button>
              <button class="btn btn-sm btn-outline-danger <%= opportunity.Stage === 'Lost' ? 'active' : '' %>" onclick="updateOpportunityStage(<%= opportunity.OpportunityId %>, 'Lost')">❌ Lost</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Scope Notes -->
      <div class="crm-card">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-file-text text-secondary"></i> Commercial Scope & Notes</span>
        </div>
        <div class="crm-card-body">
          <p class="text-sm text-secondary mb-0"><%= opportunity.Notes || 'No notes added for this opportunity.' %></p>
        </div>
      </div>
    </div>

    <!-- Account Details Sidebar -->
    <div class="col-lg-4">
      <div class="crm-card">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-building text-primary"></i> Linked Customer</span>
        </div>
        <div class="crm-card-body">
          <% if (opportunity.CustomerId) { %>
            <h6 class="fw-bold mb-1">
              <a href="/customers/<%= opportunity.CustomerId %>" class="text-decoration-none text-primary">
                <%= opportunity.CustomerName %>
              </a>
            </h6>
            <div class="text-xs text-muted mb-3"><%= opportunity.CustomerCompany || 'Independent Account' %></div>
            <div class="text-sm mb-2"><i class="bi bi-envelope text-muted me-2"></i><%= opportunity.CustomerEmail %></div>
            <div class="text-sm mb-3"><i class="bi bi-telephone text-muted me-2"></i><%= opportunity.CustomerPhone %></div>
            <a href="/customers/<%= opportunity.CustomerId %>" class="btn btn-sm btn-outline-primary w-100">
              View Customer 360 &rarr;
            </a>
          <% } else { %>
            <div class="text-muted text-sm">No linked customer account.</div>
          <% } %>
          <hr class="my-3">
          <div class="text-xs text-muted">
            <div class="mb-1">Owner: <strong><%= opportunity.AssignedToName || 'Unassigned' %></strong></div>
            <div class="mb-1">Target Close: <strong><%= opportunity.ExpectedCloseDate %></strong></div>
            <div>Created On: <strong><%= new Date(opportunity.CreatedDate).toLocaleDateString() %></strong></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
