<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <a href="/leads" class="text-decoration-none text-muted text-sm">&larr; Back to Leads</a>
      <div class="d-flex align-items-center gap-2 mt-1">
        <h3 class="fw-bold mb-0"><%= lead.LeadName %></h3>
        <span class="badge bg-light text-dark border font-monospace"><%= lead.LeadCode %></span>
        <span class="badge-status status-<%= lead.Status.toLowerCase() %>"><%= lead.Status %></span>
        <span class="badge priority-<%= lead.Priority.toLowerCase() %>"><%= lead.Priority %> Priority</span>
      </div>
    </div>

    <div class="d-flex align-items-center gap-2">
      <% if (lead.Status !== 'Converted') { %>
        <button type="button" class="btn btn-success fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#convertLeadModal">
          <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
        </button>
      <% } else { %>
        <span class="badge bg-success-subtle text-success border px-3 py-2">
          <i class="bi bi-check-all me-1"></i> Converted to Customer
        </span>
      <% } %>
      <a href="/followups/create?leadId=<%= lead.LeadId %>" class="btn btn-crm-outline">
        <i class="bi bi-calendar-plus"></i> Follow-Up
      </a>
      <a href="/activities/create?leadId=<%= lead.LeadId %>" class="btn btn-crm-outline">
        <i class="bi bi-telephone-plus"></i> Log Activity
      </a>
      <a href="/leads/<%= lead.LeadId %>/edit" class="btn btn-crm-primary">
        <i class="bi bi-pencil"></i> Edit Lead
      </a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="crm-card">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-funnel-fill text-primary"></i> Prospect Profile</span>
        </div>
        <div class="crm-card-body">
          <div class="row g-3">
            <div class="col-sm-6">
              <div class="text-xs text-muted fw-bold text-uppercase">Company</div>
              <div class="fw-semibold text-dark"><%= lead.CompanyName || 'Not Provided' %></div>
            </div>
            <div class="col-sm-6">
              <div class="text-xs text-muted fw-bold text-uppercase">Estimated Value</div>
              <div class="fw-bold text-success fs-5">$<%= Number(lead.ExpectedValue).toLocaleString() %></div>
            </div>
            <div class="col-sm-6">
              <div class="text-xs text-muted fw-bold text-uppercase">Email Address</div>
              <div><a href="mailto:<%= lead.Email %>" class="text-decoration-none"><%= lead.Email %></a></div>
            </div>
            <div class="col-sm-6">
              <div class="text-xs text-muted fw-bold text-uppercase">Phone Number</div>
              <div><a href="tel:<%= lead.Phone %>" class="text-decoration-none"><%= lead.Phone %></a></div>
            </div>
            <div class="col-sm-6">
              <div class="text-xs text-muted fw-bold text-uppercase">Lead Source</div>
              <div><span class="badge bg-light text-dark border"><%= lead.Source %></span></div>
            </div>
            <div class="col-sm-6">
              <div class="text-xs text-muted fw-bold text-uppercase">Assigned Executive</div>
              <div class="fw-semibold text-primary"><i class="bi bi-person-check me-1"></i><%= lead.AssignedToName || 'Unassigned' %></div>
            </div>
          </div>

          <hr class="my-3">
          
          <div>
            <div class="text-xs text-muted fw-bold text-uppercase mb-1">Discovery Notes</div>
            <div class="p-3 bg-light rounded-3 border text-secondary text-sm">
              <%= lead.Notes || 'No notes added yet.' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="crm-card">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-diagram-3-fill text-info"></i> Lifecycle & Conversion Status</span>
        </div>
        <div class="crm-card-body">
          <% if (lead.Status === 'Converted') { %>
            <div class="alert alert-success border-success">
              <div class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-1"></i> Conversion Completed</div>
              <div class="text-sm mb-2">This lead has been graduated to an active Customer and sales pipeline Deal.</div>
              <% if (lead.ConvertedCustomerId) { %>
                <div>
                  <strong>Customer:</strong> 
                  <a href="/customers/<%= lead.ConvertedCustomerId %>" class="text-decoration-none fw-bold">
                    <%= lead.ConvertedCustomerName || 'View Customer #' + lead.ConvertedCustomerId %> &rarr;
                  </a>
                </div>
              <% } %>
              <% if (lead.ConvertedOpportunityId) { %>
                <div class="mt-1">
                  <strong>Opportunity:</strong> 
                  <a href="/opportunities/<%= lead.ConvertedOpportunityId %>" class="text-decoration-none fw-bold">
                    <%= lead.ConvertedOpportunityName || 'View Deal #' + lead.ConvertedOpportunityId %> &rarr;
                  </a>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="p-3 bg-light rounded-3 border mb-3">
              <div class="fw-bold text-sm mb-1">Ready to Qualify?</div>
              <p class="text-muted text-xs mb-3">
                Converting this lead will automatically generate an active Customer Master record, map all contact details, and open a new Opportunity in your sales pipeline.
              </p>
              <button type="button" class="btn btn-sm btn-success w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#convertLeadModal">
                <i class="bi bi-arrow-right-circle me-1"></i> Convert to Customer & Opportunity
              </button>
            </div>
          <% } %>

          <div class="text-xs text-muted mt-3">
            <div>Captured On: <strong><%= new Date(lead.CreatedDate).toLocaleString() %></strong></div>
            <div>Last Updated: <strong><%= new Date(lead.ModifiedDate).toLocaleString() %></strong></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Convert Lead Modal -->
<div class="modal fade" id="convertLeadModal" tabindex="-1" aria-labelledby="convertLeadModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/leads/<%= lead.LeadId %>/convert" method="POST" data-validate="true">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="convertLeadModalLabel">
            <i class="bi bi-arrow-repeat text-success me-1"></i> Convert Lead to Customer
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-info py-2 text-xs mb-3">
            This will create a new Customer record from <strong><%= lead.LeadName %></strong> and open a new sales deal.
          </div>

          <div class="mb-3">
            <label class="form-label">Customer Name</label>
            <input type="text" name="CustomerName" class="form-control form-control-sm" value="<%= lead.CompanyName || lead.LeadName %>" required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">City</label>
              <input type="text" name="City" class="form-control form-control-sm" placeholder="City">
            </div>
            <div class="col-6">
              <label class="form-label">State</label>
              <input type="text" name="State" class="form-control form-control-sm" placeholder="State">
            </div>
          </div>

          <hr>

          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="createOppCheck" name="createOpportunity" value="true" checked onchange="document.getElementById('oppFields').classList.toggle('d-none', !this.checked)">
            <label class="form-check-label fw-bold text-sm" for="createOppCheck">
              Create a new Opportunity for this account
            </label>
          </div>

          <div id="oppFields">
            <div class="mb-2">
              <label class="form-label text-xs">Deal Name</label>
              <input type="text" name="OpportunityName" class="form-control form-control-sm" value="<%= (lead.CompanyName || lead.LeadName) + ' - New Contract' %>">
            </div>
            <div class="row g-2 mb-2">
              <div class="col-6">
                <label class="form-label text-xs">Deal Amount ($)</label>
                <input type="number" name="Amount" class="form-control form-control-sm" value="<%= lead.ExpectedValue || '25000' %>" min="1" required>
              </div>
              <div class="col-6">
                <label class="form-label text-xs">Stage</label>
                <select name="Stage" class="form-select form-select-sm">
                  <option value="Qualification" selected>Qualification</option>
                  <option value="Proposal">Proposal</option>
                  <option value="Negotiation">Negotiation</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-success fw-bold px-3">
            <i class="bi bi-check-circle me-1"></i> Confirm Conversion
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
