<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1">Lead Management</h3>
      <p class="text-muted mb-0">Inbound & outbound prospects &bull; <%= total %> total leads</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/reports/leads/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-crm-outline">
        <i class="bi bi-file-earmark-arrow-down"></i> Export CSV
      </a>
      <a href="/leads/create" class="btn btn-crm-primary">
        <i class="bi bi-plus-lg"></i> Capture Lead
      </a>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="crm-card mb-4">
    <div class="crm-card-body p-3">
      <form action="/leads" method="GET" class="row g-2 align-items-center">
        <div class="col-md-3">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Search lead, code, email..." value="<%= filters.search %>">
          </div>
        </div>
        <div class="col-md-2">
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Statuses --</option>
            <option value="New" <%= filters.status === 'New' ? 'selected' : '' %>>New</option>
            <option value="Contacted" <%= filters.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
            <option value="Qualified" <%= filters.status === 'Qualified' ? 'selected' : '' %>>Qualified</option>
            <option value="Unqualified" <%= filters.status === 'Unqualified' ? 'selected' : '' %>>Unqualified</option>
            <option value="Converted" <%= filters.status === 'Converted' ? 'selected' : '' %>>Converted</option>
            <option value="Lost" <%= filters.status === 'Lost' ? 'selected' : '' %>>Lost</option>
          </select>
        </div>
        <div class="col-md-2">
          <select name="source" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Sources --</option>
            <option value="Website" <%= filters.source === 'Website' ? 'selected' : '' %>>Website</option>
            <option value="Referral" <%= filters.source === 'Referral' ? 'selected' : '' %>>Referral</option>
            <option value="LinkedIn" <%= filters.source === 'LinkedIn' ? 'selected' : '' %>>LinkedIn</option>
            <option value="Cold Call" <%= filters.source === 'Cold Call' ? 'selected' : '' %>>Cold Call</option>
            <option value="Exhibition" <%= filters.source === 'Exhibition' ? 'selected' : '' %>>Exhibition</option>
            <option value="Email Campaign" <%= filters.source === 'Email Campaign' ? 'selected' : '' %>>Email Campaign</option>
          </select>
        </div>
        <div class="col-md-2">
          <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- Priority --</option>
            <option value="Low" <%= filters.priority === 'Low' ? 'selected' : '' %>>Low</option>
            <option value="Medium" <%= filters.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
            <option value="High" <%= filters.priority === 'High' ? 'selected' : '' %>>High</option>
            <option value="Urgent" <%= filters.priority === 'Urgent' ? 'selected' : '' %>>Urgent</option>
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
          <% if (filters.search || filters.status || filters.source || filters.priority) { %>
            <a href="/leads" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Lead Records Table -->
  <div class="crm-card">
    <div class="crm-card-body p-0">
      <div class="table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Lead Code</th>
              <th>Lead Name / Company</th>
              <th>Source</th>
              <th>Priority</th>
              <th>Status</th>
              <th>Est. Value</th>
              <th>Assigned Executive</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (leads && leads.length > 0) { %>
              <% leads.forEach(l => { %>
                <tr>
                  <td>
                    <span class="badge bg-light text-dark border font-monospace"><%= l.LeadCode %></span>
                  </td>
                  <td>
                    <a href="/leads/<%= l.LeadId %>" class="fw-bold text-primary text-decoration-none d-block">
                      <%= l.LeadName %>
                    </a>
                    <span class="text-xs text-muted"><%= l.CompanyName || 'No company' %> &bull; <%= l.Email %></span>
                  </td>
                  <td class="text-sm">
                    <span class="badge bg-light text-secondary border"><%= l.Source %></span>
                  </td>
                  <td>
                    <span class="badge priority-<%= l.Priority.toLowerCase() %> px-2 py-1">
                      <%= l.Priority %>
                    </span>
                  </td>
                  <td>
                    <span class="badge-status status-<%= l.Status.toLowerCase() %>">
                      <%= l.Status %>
                    </span>
                  </td>
                  <td class="fw-bold text-sm">
                    $<%= Number(l.ExpectedValue).toLocaleString() %>
                  </td>
                  <td class="text-sm">
                    <%= l.AssignedToName || 'Unassigned' %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/leads/<%= l.LeadId %>" class="btn btn-outline-secondary" title="View Lead Details">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/leads/<%= l.LeadId %>/edit" class="btn btn-outline-secondary" title="Edit Lead">
                        <i class="bi bi-pencil"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-5">
                  <i class="bi bi-funnel fs-1 d-block mb-2 text-secondary"></i>
                  No leads found matching the criteria.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="crm-card-header bg-light py-2">
      <div class="text-xs text-muted">Page <%= currentPage %> of <%= totalPages %> (<%= total %> total records)</div>
      <nav aria-label="Table pagination">
        <ul class="pagination pagination-sm mb-0">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/leads?page=<%= i %>&search=<%= filters.search %>&status=<%= filters.status %>&source=<%= filters.source %>">
                <%= i %>
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
    <% } %>
  </div>
</div>
