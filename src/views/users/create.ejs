<div class="container-fluid px-0" style="max-width: 700px;">
  
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <a href="/users" class="text-decoration-none text-muted text-sm">&larr; Back to Users</a>
      <h3 class="fw-bold mt-1 mb-0">Create User Account</h3>
    </div>
  </div>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger py-2 mb-4" role="alert">
      <ul class="mb-0 ps-3">
        <% errors.forEach(err => { %>
          <li><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="crm-card">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-person-plus text-primary"></i> Account Credentials & Role</span>
    </div>
    <div class="crm-card-body p-4">
      <form action="/users/create" method="POST" data-validate="true">
        
        <div class="mb-3">
          <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="name" name="Name" value="<%= typeof formData !== 'undefined' ? formData.Name : '' %>" placeholder="e.g. Ananya Sen" required autofocus>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Work Email <span class="text-danger">*</span></label>
          <input type="email" class="form-control" id="email" name="Email" value="<%= typeof formData !== 'undefined' ? formData.Email : '' %>" placeholder="ananya.sen@acxiomcrm.com" required>
        </div>

        <div class="mb-3">
          <label for="roleName" class="form-label">Role Assignment <span class="text-danger">*</span></label>
          <select class="form-select" id="roleName" name="RoleName" required>
            <% roles.forEach(r => { %>
              <option value="<%= r.RoleName %>" <%= r.RoleName === 'SalesExecutive' ? 'selected' : '' %>>
                <%= r.RoleName %>
              </option>
            <% }) %>
          </select>
          <div class="form-text text-xs">
            <strong>Admin:</strong> Full system access &bull; <strong>Manager:</strong> Team pipeline &bull; <strong>SalesExecutive:</strong> Scoped records.
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Initial Password <span class="text-danger">*</span></label>
          <input type="password" class="form-control" id="password" name="Password" placeholder="Min. 8 chars (upper, lower, digit)" required>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
          <a href="/users" class="btn btn-crm-outline">Cancel</a>
          <button type="submit" class="btn btn-crm-primary px-4">
            <i class="bi bi-check2-circle"></i> Create Account
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
