<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1">User & Role Administration</h3>
      <p class="text-muted mb-0">Role-Based Access Control &bull; <%= total %> total user accounts</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/users/create" class="btn btn-crm-primary">
        <i class="bi bi-person-plus-fill"></i> Create User
      </a>
    </div>
  </div>

  <!-- Search & Role Filter -->
  <div class="crm-card mb-4">
    <div class="crm-card-body p-3">
      <form action="/users" method="GET" class="row g-2 align-items-center">
        <div class="col-md-5">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Search by name, email, or role..." value="<%= filters.search %>">
          </div>
        </div>
        <div class="col-md-3">
          <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Roles --</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.RoleName %>" <%= filters.role === r.RoleName ? 'selected' : '' %>><%= r.RoleName %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- Status --</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
          <% if (filters.search || filters.role || filters.status) { %>
            <a href="/users" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Users Table -->
  <div class="crm-card">
    <div class="crm-card-body p-0">
      <div class="table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>User Name</th>
              <th>Work Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Security / Lockout</th>
              <th>Created Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="avatar-circle" style="width: 32px; height: 32px; font-size: 0.8rem;">
                        <%= u.Name.charAt(0).toUpperCase() %>
                      </div>
                      <span class="fw-bold text-dark"><%= u.Name %></span>
                    </div>
                  </td>
                  <td class="text-sm">
                    <%= u.Email %>
                  </td>
                  <td>
                    <span class="role-tag role-<%= u.RoleName.toLowerCase() %>">
                      <%= u.RoleName %>
                    </span>
                  </td>
                  <td>
                    <% if (u.IsActive) { %>
                      <span class="badge bg-success-subtle text-success border">Active</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger border">Inactive</span>
                    <% } %>
                  </td>
                  <td class="text-sm">
                    <% if (u.isLocked) { %>
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger text-white"><i class="bi bi-lock-fill me-1"></i> Locked</span>
                        <form action="/users/<%= u.UserId %>/unlock" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-xs btn-outline-success py-0 px-2 text-xs">Unlock</button>
                        </form>
                      </div>
                    <% } else { %>
                      <span class="text-xs text-muted">Normal (<%= u.FailedLoginCount %> failed attempts)</span>
                    <% } %>
                  </td>
                  <td class="text-sm text-muted">
                    <%= new Date(u.CreatedDate).toLocaleDateString() %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <button type="button" class="btn btn-outline-secondary" onclick="openResetPasswordModal(<%= u.UserId %>, '<%= u.Name %>')" title="Reset Password">
                        <i class="bi bi-key"></i>
                      </button>
                      <a href="/users/<%= u.UserId %>/edit" class="btn btn-outline-secondary" title="Edit User">
                        <i class="bi bi-pencil"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-5">No user accounts found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="resetPasswordForm" method="POST" data-validate="true">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="resetPasswordModalLabel">
            <i class="bi bi-key-fill text-warning me-1"></i> Admin Password Reset
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-sm text-muted mb-3">
            Reset password for user: <strong id="resetUserName"></strong>
          </p>
          <div class="mb-3">
            <label class="form-label">New Temporary / Permanent Password <span class="text-danger">*</span></label>
            <input type="password" name="newPassword" class="form-control" placeholder="Min. 8 chars (upper, lower, number)" required autofocus>
            <div class="form-text text-xs">Must fulfill password complexity policy.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary fw-semibold px-3">Update Password</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openResetPasswordModal(userId, name) {
    document.getElementById('resetPasswordForm').action = `/users/${userId}/reset-password`;
    document.getElementById('resetUserName').innerText = name;
    new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
  }
</script>
