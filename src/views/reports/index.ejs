<div class="container-fluid px-0">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-bold mb-1">Business Intelligence & Reports</h3>
      <p class="text-muted mb-0">Role-scoped analytics, pipeline forecasts, and structured exports</p>
    </div>
  </div>

  <!-- Reports Grid -->
  <div class="row g-4">
    
    <!-- 1. Customer Master Report -->
    <div class="col-md-6 col-lg-4">
      <div class="crm-card h-100">
        <div class="crm-card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kpi-icon-box icon-blue">
              <i class="bi bi-buildings-fill"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">Customer Master</h5>
              <span class="text-xs text-muted">Accounts & Distribution</span>
            </div>
          </div>
          <p class="text-sm text-secondary flex-grow-1">
            Analyze customer growth, status segmentation (Active/Inactive), and account distribution by sales executive.
          </p>
          <div class="d-flex gap-2 pt-3 border-top">
            <a href="/reports/customers" class="btn btn-sm btn-primary w-100">View Report</a>
            <a href="/reports/customers/export" class="btn btn-sm btn-outline-secondary" title="Direct CSV Export"><i class="bi bi-download"></i></a>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Lead Funnel Report -->
    <div class="col-md-6 col-lg-4">
      <div class="crm-card h-100">
        <div class="crm-card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kpi-icon-box icon-purple">
              <i class="bi bi-funnel-fill"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">Lead Conversion</h5>
              <span class="text-xs text-muted">Funnel & Source Yield</span>
            </div>
          </div>
          <p class="text-sm text-secondary flex-grow-1">
            Examine inbound lead acquisition across Website, LinkedIn, Referrals, and track conversion rates into won deals.
          </p>
          <div class="d-flex gap-2 pt-3 border-top">
            <a href="/reports/leads" class="btn btn-sm btn-primary w-100">View Report</a>
            <a href="/reports/leads/export" class="btn btn-sm btn-outline-secondary" title="Direct CSV Export"><i class="bi bi-download"></i></a>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Opportunity Pipeline Report -->
    <div class="col-md-6 col-lg-4">
      <div class="crm-card h-100">
        <div class="crm-card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kpi-icon-box icon-amber">
              <i class="bi bi-bar-chart-steps"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">Pipeline Valuation</h5>
              <span class="text-xs text-muted">Stage & Forecast Analysis</span>
            </div>
          </div>
          <p class="text-sm text-secondary flex-grow-1">
            Stage-wise and owner-wise valuation with weighted probability forecasts (<span class="font-monospace text-xs">Amount &times; Probability / 100</span>).
          </p>
          <div class="d-flex gap-2 pt-3 border-top">
            <a href="/reports/pipeline" class="btn btn-sm btn-primary w-100">View Report</a>
            <a href="/reports/pipeline/export" class="btn btn-sm btn-outline-secondary" title="Direct CSV Export"><i class="bi bi-download"></i></a>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Sales Leaderboard Report -->
    <div class="col-md-6 col-lg-4">
      <div class="crm-card h-100">
        <div class="crm-card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kpi-icon-box icon-green">
              <i class="bi bi-trophy-fill"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">Sales Leaderboard</h5>
              <span class="text-xs text-muted">Executive Performance</span>
            </div>
          </div>
          <p class="text-sm text-secondary flex-grow-1">
            Closed-won revenue metrics, average deal sizing, and quota achievement per sales team member.
          </p>
          <div class="d-flex gap-2 pt-3 border-top">
            <a href="/reports/sales" class="btn btn-sm btn-primary w-100">View Leaderboard</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Security & Audit Report -->
    <div class="col-md-6 col-lg-4">
      <div class="crm-card h-100">
        <div class="crm-card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kpi-icon-box icon-rose">
              <i class="bi bi-shield-check"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">Security & Audit</h5>
              <span class="text-xs text-muted">Compliance & Access Logs</span>
            </div>
          </div>
          <p class="text-sm text-secondary flex-grow-1">
            Comprehensive history of authentication attempts, account lockouts, data modifications, and role changes.
          </p>
          <div class="d-flex gap-2 pt-3 border-top">
            <a href="/reports/audit" class="btn btn-sm btn-primary w-100">View Audit Report</a>
            <a href="/reports/audit/export" class="btn btn-sm btn-outline-secondary" title="Direct CSV Export"><i class="bi bi-download"></i></a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
