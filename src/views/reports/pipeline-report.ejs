<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <a href="/reports" class="text-decoration-none text-muted text-sm">&larr; Back to Reports</a>
      <h3 class="fw-bold mt-1 mb-0">Opportunity Pipeline Valuation Report</h3>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/reports/pipeline/export" class="btn btn-crm-primary">
        <i class="bi bi-file-earmark-arrow-down"></i> Export to CSV
      </a>
    </div>
  </div>

  <!-- Stage Breakdown Summary -->
  <div class="crm-card mb-4">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-bar-chart-steps text-primary"></i> Stage-Wise Pipeline Valuation & Weighted Forecast</span>
    </div>
    <div class="crm-card-body p-0">
      <div class="table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Pipeline Stage</th>
              <th>Deals Count</th>
              <th>Total Pipeline Amount ($)</th>
              <th>Avg. Win Probability</th>
              <th>Weighted Forecast ($)</th>
            </tr>
          </thead>
          <tbody>
            <% stageSummary.forEach(s => { %>
              <tr>
                <td><span class="badge-status status-<%= s.Stage.toLowerCase() %>"><%= s.Stage %></span></td>
                <td class="fw-semibold"><%= s.DealCount %></td>
                <td class="fw-bold text-dark">$<%= Number(s.TotalAmount).toLocaleString() %></td>
                <td class="text-sm"><%= Math.round(s.AvgProbability) %>%</td>
                <td class="fw-bold text-success">$<%= Number(s.WeightedAmount).toLocaleString(undefined, {maximumFractionDigits: 0}) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Executive Owner Breakdown -->
  <div class="crm-card">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-people-fill text-info"></i> Owner-Wise Pipeline Allocation</span>
    </div>
    <div class="crm-card-body p-0">
      <div class="table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Account Owner</th>
              <th>Active Deals</th>
              <th>Open Pipeline Value ($)</th>
              <th>Closed-Won Revenue ($)</th>
              <th>Weighted Pipeline Forecast ($)</th>
            </tr>
          </thead>
          <tbody>
            <% ownerSummary.forEach(o => { %>
              <tr>
                <td class="fw-bold text-dark"><%= o.OwnerName %></td>
                <td class="fw-semibold"><%= o.DealCount %></td>
                <td class="fw-bold text-primary">$<%= Number(o.OpenPipeline).toLocaleString() %></td>
                <td class="fw-bold text-success">$<%= Number(o.WonRevenue).toLocaleString() %></td>
                <td class="fw-bold text-dark">$<%= Number(o.WeightedPipeline).toLocaleString(undefined, {maximumFractionDigits: 0}) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
