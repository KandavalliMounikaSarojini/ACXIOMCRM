<div class="container-fluid px-0">
  
  <!-- Dashboard Header & Actions -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1">Executive Dashboard</h3>
      <p class="text-muted mb-0">
        Welcome back, <strong><%= user.name %></strong> &bull; Scoped as <span class="role-tag role-<%= user.roleName.toLowerCase() %>"><%= user.roleName %></span>
      </p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/leads/create" class="btn btn-crm-primary">
        <i class="bi bi-plus-lg"></i> Capture Lead
      </a>
      <a href="/opportunities/create" class="btn btn-crm-outline">
        <i class="bi bi-currency-dollar"></i> New Opportunity
      </a>
      <a href="/followups/create" class="btn btn-crm-outline">
        <i class="bi bi-calendar-plus"></i> Schedule Follow-Up
      </a>
    </div>
  </div>

  <!-- Overdue Follow-Up Alert Banner if any -->
  <% if (kpis.overdueFollowUps > 0) { %>
    <div class="alert alert-warning border-warning d-flex align-items-center justify-content-between mb-4 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-octagon-fill fs-4 text-warning"></i>
        <div>
          <div class="fw-bold">Action Required: <%= kpis.overdueFollowUps %> Overdue Follow-Up(s)</div>
          <div class="text-sm">You have scheduled activities that have passed their deadline. Please review or reschedule them.</div>
        </div>
      </div>
      <a href="/followups?timeFilter=overdue" class="btn btn-sm btn-warning text-dark fw-bold">
        View Overdue (<%= kpis.overdueFollowUps %>)
      </a>
    </div>
  <% } %>

  <!-- Row 1: KPI Cards -->
  <div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-label">Customers</div>
          <div class="kpi-value"><%= kpis.totalCustomers %></div>
          <div class="kpi-sub"><i class="bi bi-shield-check text-success me-1"></i>Active accounts</div>
        </div>
        <div class="kpi-icon-box icon-blue">
          <i class="bi bi-buildings-fill"></i>
        </div>
      </div>
    </div>

    <!-- Total Leads -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-label">Open Leads</div>
          <div class="kpi-value"><%= kpis.openLeads %> <span class="fs-6 text-muted">/ <%= kpis.totalLeads %></span></div>
          <div class="kpi-sub"><span class="text-primary fw-semibold"><%= kpis.convertedLeads %></span> converted</div>
        </div>
        <div class="kpi-icon-box icon-purple">
          <i class="bi bi-funnel-fill"></i>
        </div>
      </div>
    </div>

    <!-- Active Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-label">Active Pipeline</div>
          <div class="kpi-value">$<%= Number(kpis.totalPipelineValue).toLocaleString() %></div>
          <div class="kpi-sub">Weighted: <strong class="text-success">$<%= Number(kpis.weightedPipelineValue).toLocaleString(undefined, {maximumFractionDigits: 0}) %></strong></div>
        </div>
        <div class="kpi-icon-box icon-amber">
          <i class="bi bi-graph-up-arrow"></i>
        </div>
      </div>
    </div>

    <!-- Won Revenue -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-label">Won Revenue</div>
          <div class="kpi-value text-success">$<%= Number(kpis.wonRevenue).toLocaleString() %></div>
          <div class="kpi-sub"><i class="bi bi-trophy-fill text-warning me-1"></i><%= kpis.wonOpportunities %> deals closed</div>
        </div>
        <div class="kpi-icon-box icon-green">
          <i class="bi bi-award-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 2: Visual Charts -->
  <div class="row g-4 mb-4">
    <!-- Opportunity Pipeline Chart -->
    <div class="col-lg-8">
      <div class="crm-card mb-0 h-100">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-bar-chart-steps text-primary"></i> Opportunity Pipeline by Stage</span>
          <a href="/opportunities/kanban" class="btn btn-sm btn-outline-secondary">Kanban Board &rarr;</a>
        </div>
        <div class="crm-card-body" style="height: 300px; position: relative;">
          <canvas id="pipelineChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Lead Status Doughnut Chart -->
    <div class="col-lg-4">
      <div class="crm-card mb-0 h-100">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-pie-chart-fill text-info"></i> Lead Funnel Status</span>
          <a href="/leads" class="btn btn-sm btn-outline-secondary">All Leads</a>
        </div>
        <div class="crm-card-body" style="height: 300px; position: relative;">
          <canvas id="leadStatusChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Monthly Sales Line Chart -->
  <div class="crm-card mb-4">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-graph-up text-success"></i> Monthly Closed-Won Revenue Performance</span>
      <a href="/reports/sales" class="btn btn-sm btn-outline-secondary">Sales Reports</a>
    </div>
    <div class="crm-card-body" style="height: 250px; position: relative;">
      <canvas id="monthlySalesChart"></canvas>
    </div>
  </div>

  <!-- Row 3: Quick Action Tables -->
  <div class="row g-4">
    
    <!-- Upcoming Follow-ups -->
    <div class="col-lg-6">
      <div class="crm-card mb-0">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-calendar-event text-primary"></i> Upcoming Follow-Ups</span>
          <a href="/followups" class="btn btn-sm btn-link text-decoration-none">View All</a>
        </div>
        <div class="crm-card-body p-0">
          <div class="table-responsive">
            <table class="crm-table">
              <thead>
                <tr>
                  <th>Activity / Subject</th>
                  <th>Date & Time</th>
                  <th>Contact</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (upcomingFollowUps && upcomingFollowUps.length > 0) { %>
                  <% upcomingFollowUps.forEach(f => { %>
                    <tr>
                      <td>
                        <div class="fw-semibold"><%= f.Subject %></div>
                        <span class="badge bg-light text-dark border text-xs"><%= f.FollowUpType %></span>
                      </td>
                      <td class="text-sm">
                        <%= new Date(f.FollowUpDate).toLocaleDateString() %> 
                        <div class="text-xs text-muted"><%= new Date(f.FollowUpDate).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                      </td>
                      <td class="text-sm">
                        <%= f.CustomerName || f.LeadName || 'General' %>
                      </td>
                      <td>
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 text-xs" onclick="completeFollowUp(<%= f.FollowUpId %>)">
                          <i class="bi bi-check-lg"></i> Done
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center text-muted py-3">No upcoming follow-ups scheduled.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Opportunities -->
    <div class="col-lg-6">
      <div class="crm-card mb-0">
        <div class="crm-card-header">
          <span class="crm-card-title"><i class="bi bi-briefcase-fill text-warning"></i> Recent High-Value Opportunities</span>
          <a href="/opportunities" class="btn btn-sm btn-link text-decoration-none">View All</a>
        </div>
        <div class="crm-card-body p-0">
          <div class="table-responsive">
            <table class="crm-table">
              <thead>
                <tr>
                  <th>Opportunity</th>
                  <th>Amount</th>
                  <th>Stage</th>
                  <th>Close Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentOpportunities && recentOpportunities.length > 0) { %>
                  <% recentOpportunities.forEach(o => { %>
                    <tr>
                      <td>
                        <a href="/opportunities/<%= o.OpportunityId %>" class="fw-semibold text-primary text-decoration-none">
                          <%= o.OpportunityName %>
                        </a>
                        <div class="text-xs text-muted"><%= o.CustomerName || 'Unassigned' %></div>
                      </td>
                      <td class="fw-bold text-sm">
                        $<%= Number(o.Amount).toLocaleString() %>
                      </td>
                      <td>
                        <span class="badge-status status-<%= o.Stage.toLowerCase() %>">
                          <%= o.Stage %> (<%= o.Probability %>%)
                        </span>
                      </td>
                      <td class="text-sm text-muted">
                        <%= o.ExpectedCloseDate %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center text-muted py-3">No opportunities found.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
