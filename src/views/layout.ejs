<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'AcxiomCRM Enterprise' %></title>
  <meta name="description" content="AcxiomCRM - Enterprise Role-Based CRM System with Layered Architecture, Auditing, REST APIs, and Real-Time Analytics">
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS & Icons CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <% if (currentUser) { %>
  <!-- Authenticated Application Shell -->
  <div class="app-container">
    
    <!-- Sidebar Navigation -->
    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-header">
        <div class="brand-logo">A</div>
        <div>
          <div class="brand-title">AcxiomCRM</div>
          <div style="font-size: 0.65rem; color: #94a3b8; letter-spacing: 0.05em;">ENTERPRISE SUITE</div>
        </div>
      </div>

      <div class="sidebar-section-title">CORE MODULES</div>
      <ul class="sidebar-nav">
        <li class="sidebar-item">
          <a href="/dashboard" class="sidebar-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Dashboard</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/customers" class="sidebar-link <%= currentPath.startsWith('/customers') ? 'active' : '' %>">
            <i class="bi bi-buildings-fill"></i>
            <span>Customers</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/leads" class="sidebar-link <%= currentPath.startsWith('/leads') ? 'active' : '' %>">
            <i class="bi bi-funnel-fill"></i>
            <span>Leads</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/opportunities" class="sidebar-link <%= currentPath.startsWith('/opportunities') && currentPath !== '/opportunities/kanban' ? 'active' : '' %>">
            <i class="bi bi-currency-dollar"></i>
            <span>Opportunities</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/opportunities/kanban" class="sidebar-link <%= currentPath === '/opportunities/kanban' ? 'active' : '' %>">
            <i class="bi bi-kanban-fill"></i>
            <span>Pipeline Board</span>
          </a>
        </li>
      </ul>

      <div class="sidebar-section-title">ENGAGEMENT</div>
      <ul class="sidebar-nav">
        <li class="sidebar-item">
          <a href="/followups" class="sidebar-link <%= currentPath.startsWith('/followups') ? 'active' : '' %>">
            <i class="bi bi-calendar-check-fill"></i>
            <span>Follow-Ups</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/activities" class="sidebar-link <%= currentPath.startsWith('/activities') ? 'active' : '' %>">
            <i class="bi bi-clock-history"></i>
            <span>Activities</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/reports" class="sidebar-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>">
            <i class="bi bi-bar-chart-line-fill"></i>
            <span>Reports & KPIs</span>
          </a>
        </li>
      </ul>

      <% if (currentUser.roleName === 'Admin' || currentUser.roleName === 'Manager') { %>
      <div class="sidebar-section-title">GOVERNANCE</div>
      <ul class="sidebar-nav">
        <% if (currentUser.roleName === 'Admin') { %>
        <li class="sidebar-item">
          <a href="/users" class="sidebar-link <%= currentPath.startsWith('/users') ? 'active' : '' %>">
            <i class="bi bi-people-fill"></i>
            <span>User & Roles</span>
          </a>
        </li>
        <% } %>
        <li class="sidebar-item">
          <a href="/audit" class="sidebar-link <%= currentPath.startsWith('/audit') ? 'active' : '' %>">
            <i class="bi bi-shield-check"></i>
            <span>Audit Logs</span>
          </a>
        </li>
      </ul>
      <% } %>
    </aside>

    <!-- Main Wrapper -->
    <div class="app-main">
      
      <!-- Top Header Navbar -->
      <header class="app-header">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('appSidebar').classList.toggle('show')">
            <i class="bi bi-list fs-5"></i>
          </button>
          
          <form action="/customers" method="GET" class="search-container d-none d-md-block">
            <i class="bi bi-search"></i>
            <input type="text" name="search" placeholder="Search customers, leads, codes..." aria-label="Global Search">
          </form>
        </div>

        <div class="d-flex align-items-center gap-3">
          <div class="user-badge">
            <div class="avatar-circle">
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <div class="d-none d-sm-block text-start">
              <div class="fw-semibold text-sm lh-1" style="font-size: 0.875rem;"><%= currentUser.name %></div>
              <span class="role-tag role-<%= currentUser.roleName.toLowerCase() %> mt-1 d-inline-block">
                <%= currentUser.roleName %>
              </span>
            </div>
          </div>

          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-gear-fill"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
              <li><h6 class="dropdown-header">Signed in as <%= currentUser.email %></h6></li>
              <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Main Body Container -->
      <main class="app-content">
        
        <!-- Flash Alerts -->
        <% if (flashSuccess) { %>
          <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= flashSuccess %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <% if (flashError) { %>
          <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= flashError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <%- body %>
      </main>

      <!-- Footer -->
      <footer class="text-center py-3 text-muted text-xs border-top bg-white" style="font-size: 0.8rem;">
        AcxiomCRM &copy; 2026 Enterprise Edition &bull; All Rights Reserved.
      </footer>
    </div>
  </div>

  <% } else { %>
  <!-- Anonymous Layout (Login / Register) -->
  <main class="auth-page-wrapper">
    <%- body %>
  </main>
  <% } %>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  <!-- Core CRM Scripts -->
  <script src="/js/main.js"></script>
  <script src="/js/dashboard-charts.js"></script>
  <script src="/js/api-tester.js"></script>
</body>
</html>
