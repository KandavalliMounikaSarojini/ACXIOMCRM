<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1">Activity Feed & History</h3>
      <p class="text-muted mb-0">Engagement timeline across calls, meetings, emails & tasks &bull; <%= total %> total logs</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/activities/create" class="btn btn-crm-primary">
        <i class="bi bi-plus-lg"></i> Log Activity
      </a>
    </div>
  </div>

  <!-- Type Filters -->
  <div class="crm-card mb-4">
    <div class="crm-card-body p-3">
      <form action="/activities" method="GET" class="row g-2 align-items-center">
        <div class="col-md-4">
          <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Activity Types --</option>
            <option value="Call" <%= filters.type === 'Call' ? 'selected' : '' %>>📞 Phone Call</option>
            <option value="Meeting" <%= filters.type === 'Meeting' ? 'selected' : '' %>>🤝 Meeting</option>
            <option value="Email" <%= filters.type === 'Email' ? 'selected' : '' %>>✉️ Email</option>
            <option value="Task" <%= filters.type === 'Task' ? 'selected' : '' %>>📋 Task</option>
          </select>
        </div>
        <div class="col-md-4">
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Statuses --</option>
            <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            <option value="In-Progress" <%= filters.status === 'In-Progress' ? 'selected' : '' %>>In-Progress</option>
            <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
          </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
          <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
          <% if (filters.type || filters.status) { %>
            <a href="/activities" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Activity Timeline List -->
  <div class="crm-card">
    <div class="crm-card-body p-4">
      <% if (activities && activities.length > 0) { %>
        <div class="list-group list-group-flush">
          <% activities.forEach(a => { %>
            <div class="list-group-item px-0 py-3 border-bottom">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-primary-subtle text-primary border px-2 py-1"><%= a.ActivityType %></span>
                  <span class="fw-bold text-dark fs-6"><%= a.Subject %></span>
                  <span class="badge-status status-<%= a.Status.toLowerCase() %>"><%= a.Status %></span>
                </div>
                <span class="text-xs text-muted"><%= new Date(a.ActivityDate).toLocaleString() %></span>
              </div>
              <p class="text-sm text-secondary mb-2"><%= a.Description || 'No detailed description provided.' %></p>
              <div class="d-flex align-items-center gap-3 text-xs text-muted">
                <span><i class="bi bi-person me-1"></i><%= a.AssignedToName %></span>
                <% if (a.CustomerId) { %>
                  <span><i class="bi bi-building me-1"></i><a href="/customers/<%= a.CustomerId %>" class="text-decoration-none"><%= a.CustomerName %></a></span>
                <% } %>
                <% if (a.LeadId) { %>
                  <span><i class="bi bi-funnel me-1"></i><a href="/leads/<%= a.LeadId %>" class="text-decoration-none"><%= a.LeadName %></a></span>
                <% } %>
                <% if (a.OpportunityId) { %>
                  <span><i class="bi bi-currency-dollar me-1"></i><a href="/opportunities/<%= a.OpportunityId %>" class="text-decoration-none"><%= a.OpportunityName %></a></span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clock-history fs-1 d-block mb-2 text-secondary"></i>
          No activities logged matching the selection.
        </div>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="crm-card-header bg-light py-2">
      <div class="text-xs text-muted">Page <%= currentPage %> of <%= totalPages %> (<%= total %> total records)</div>
      <nav aria-label="Table pagination">
        <ul class="pagination pagination-sm mb-0">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/activities?page=<%= i %>&type=<%= filters.type %>&status=<%= filters.status %>">
                <%= i %>
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
    <% } %>
  </div>
</div>
