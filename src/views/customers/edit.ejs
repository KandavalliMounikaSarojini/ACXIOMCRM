<div class="container-fluid px-0" style="max-width: 800px;">
  
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <a href="/customers/<%= customer.CustomerId %>" class="text-decoration-none text-muted text-sm">&larr; Back to Details</a>
      <h3 class="fw-bold mt-1 mb-0">Edit Customer: <%= customer.CustomerName %></h3>
    </div>
  </div>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger py-2 mb-4" role="alert">
      <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please correct the following errors:</div>
      <ul class="mb-0 ps-3">
        <% errors.forEach(err => { %>
          <li><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="crm-card">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-pencil-square text-primary"></i> Edit Customer Master Record</span>
      <span class="badge bg-light text-dark border font-monospace"><%= customer.CustomerCode %></span>
    </div>
    <div class="crm-card-body p-4">
      <form action="/customers/<%= customer.CustomerId %>/edit" method="POST" data-validate="true">
        
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="customerName" class="form-label">Customer Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="customerName" name="CustomerName" value="<%= customer.CustomerName %>" required autofocus>
          </div>
          <div class="col-md-6">
            <label for="companyName" class="form-label">Company / Organization</label>
            <input type="text" class="form-control" id="companyName" name="CompanyName" value="<%= customer.CompanyName || '' %>">
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="email" name="Email" value="<%= customer.Email %>" required>
          </div>
          <div class="col-md-6">
            <label for="phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
            <input type="tel" class="form-control" id="phone" name="Phone" value="<%= customer.Phone %>" required>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="status" class="form-label">Account Status</label>
            <select class="form-select" id="status" name="Status">
              <option value="Active" <%= customer.Status === 'Active' ? 'selected' : '' %>>Active</option>
              <option value="Prospect" <%= customer.Status === 'Prospect' ? 'selected' : '' %>>Prospect</option>
              <option value="Inactive" <%= customer.Status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="ownerId" class="form-label">Assigned Sales Executive</label>
            <select class="form-select" id="ownerId" name="OwnerId">
              <% salesExecutives.forEach(exec => { %>
                <option value="<%= exec.UserId %>" <%= customer.OwnerId == exec.UserId ? 'selected' : '' %>>
                  <%= exec.Name %> (<%= exec.RoleName %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-12">
            <label for="address" class="form-label">Street Address</label>
            <input type="text" class="form-control" id="address" name="Address" value="<%= customer.Address || '' %>">
          </div>
          <div class="col-md-6">
            <label for="city" class="form-label">City</label>
            <input type="text" class="form-control" id="city" name="City" value="<%= customer.City || '' %>">
          </div>
          <div class="col-md-6">
            <label for="state" class="form-label">State / Region</label>
            <input type="text" class="form-control" id="state" name="State" value="<%= customer.State || '' %>">
          </div>
        </div>

        <div class="mb-4">
          <label for="notes" class="form-label">Internal Account Notes</label>
          <textarea class="form-control" id="notes" name="Notes" rows="3"><%= customer.Notes || '' %></textarea>
        </div>

        <div class="d-flex align-items-center justify-content-between border-top pt-3">
          <button type="button" class="btn btn-outline-danger btn-sm" onclick="document.getElementById('deleteCustomerForm').submit()">
            <i class="bi bi-trash"></i> Delete Customer
          </button>
          <div class="d-flex gap-2">
            <a href="/customers/<%= customer.CustomerId %>" class="btn btn-crm-outline">Cancel</a>
            <button type="submit" class="btn btn-crm-primary px-4">
              <i class="bi bi-check2"></i> Save Changes
            </button>
          </div>
        </div>
      </form>

      <form id="deleteCustomerForm" action="/customers/<%= customer.CustomerId %>/delete" method="POST" class="delete-confirm-form d-none" data-confirm="Are you sure you want to delete this customer? If opportunities exist, the customer will be marked Inactive.">
      </form>
    </div>
  </div>
</div>
