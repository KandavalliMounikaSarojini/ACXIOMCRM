<div class="container-fluid px-0" style="max-width: 800px;">
  
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <a href="/customers" class="text-decoration-none text-muted text-sm">&larr; Back to Customers</a>
      <h3 class="fw-bold mt-1 mb-0">Create New Customer</h3>
    </div>
  </div>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger py-2 mb-4" role="alert">
      <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please correct the following errors:</div>
      <ul class="mb-0 ps-3">
        <% errors.forEach(err => { %>
          <li><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="crm-card">
    <div class="crm-card-header">
      <span class="crm-card-title"><i class="bi bi-building-add text-primary"></i> Customer Information</span>
    </div>
    <div class="crm-card-body p-4">
      <form action="/customers/create" method="POST" data-validate="true">
        
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="customerName" class="form-label">Customer Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="customerName" name="CustomerName" value="<%= typeof formData !== 'undefined' ? formData.CustomerName : '' %>" placeholder="e.g. Rahul Sharma" required autofocus>
          </div>
          <div class="col-md-6">
            <label for="companyName" class="form-label">Company / Organization</label>
            <input type="text" class="form-control" id="companyName" name="CompanyName" value="<%= typeof formData !== 'undefined' ? formData.CompanyName : '' %>" placeholder="e.g. Nexus Technologies Ltd">
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="email" name="Email" value="<%= typeof formData !== 'undefined' ? formData.Email : '' %>" placeholder="contact@company.com" required>
            <div class="form-text text-xs">Must be a valid email and unique in system.</div>
          </div>
          <div class="col-md-6">
            <label for="phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
            <input type="tel" class="form-control" id="phone" name="Phone" value="<%= typeof formData !== 'undefined' ? formData.Phone : '' %>" placeholder="e.g. 9820011223 (10 digits)" required>
            <div class="form-text text-xs">Enter 10 to 15 digit mobile or phone number.</div>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="status" class="form-label">Account Status</label>
            <select class="form-select" id="status" name="Status">
              <option value="Active" selected>Active</option>
              <option value="Prospect">Prospect</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="ownerId" class="form-label">Assigned Sales Executive</label>
            <select class="form-select" id="ownerId" name="OwnerId">
              <% salesExecutives.forEach(exec => { %>
                <option value="<%= exec.UserId %>" <%= currentUser.userId === exec.UserId ? 'selected' : '' %>>
                  <%= exec.Name %> (<%= exec.RoleName %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-12">
            <label for="address" class="form-label">Street Address</label>
            <input type="text" class="form-control" id="address" name="Address" value="<%= typeof formData !== 'undefined' ? formData.Address : '' %>" placeholder="Office location or street address">
          </div>
          <div class="col-md-6">
            <label for="city" class="form-label">City</label>
            <input type="text" class="form-control" id="city" name="City" value="<%= typeof formData !== 'undefined' ? formData.City : '' %>" placeholder="e.g. Mumbai">
          </div>
          <div class="col-md-6">
            <label for="state" class="form-label">State / Region</label>
            <input type="text" class="form-control" id="state" name="State" value="<%= typeof formData !== 'undefined' ? formData.State : '' %>" placeholder="e.g. Maharashtra">
          </div>
        </div>

        <div class="mb-4">
          <label for="notes" class="form-label">Internal Account Notes</label>
          <textarea class="form-control" id="notes" name="Notes" rows="3" placeholder="Add any background notes, customer industry details, or preferences..."><%= typeof formData !== 'undefined' ? formData.Notes : '' %></textarea>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-3">
          <a href="/customers" class="btn btn-crm-outline">Cancel</a>
          <button type="submit" class="btn btn-crm-primary px-4">
            <i class="bi bi-check2-circle"></i> Save Customer
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
