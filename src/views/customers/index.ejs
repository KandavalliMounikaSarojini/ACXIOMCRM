<div class="container-fluid px-0">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1">Customer Directory</h3>
      <p class="text-muted mb-0">Master account directory &bull; <%= total %> total accounts in scope</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/reports/customers/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-crm-outline">
        <i class="bi bi-file-earmark-arrow-down"></i> Export CSV
      </a>
      <a href="/customers/create" class="btn btn-crm-primary">
        <i class="bi bi-plus-lg"></i> New Customer
      </a>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="crm-card mb-4">
    <div class="crm-card-body p-3">
      <form action="/customers" method="GET" class="row g-2 align-items-center">
        <div class="col-md-4">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Search name, code, email, company..." value="<%= filters.search %>">
          </div>
        </div>
        <div class="col-md-3">
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Statuses --</option>
            <option value="Active" <%= filters.status === 'Active' ? 'selected' : '' %>>Active</option>
            <option value="Inactive" <%= filters.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="Prospect" <%= filters.status === 'Prospect' ? 'selected' : '' %>>Prospect</option>
          </select>
        </div>
        <% if (currentUser.roleName !== 'SalesExecutive') { %>
        <div class="col-md-3">
          <select name="ownerId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- All Account Owners --</option>
            <% salesExecutives.forEach(exec => { %>
              <option value="<%= exec.UserId %>" <%= filters.ownerId == exec.UserId ? 'selected' : '' %>>
                <%= exec.Name %> (<%= exec.RoleName %>)
              </option>
            <% }) %>
          </select>
        </div>
        <% } %>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
          <% if (filters.search || filters.status || filters.ownerId) { %>
            <a href="/customers" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Customer Records Table -->
  <div class="crm-card">
    <div class="crm-card-body p-0">
      <div class="table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Customer Code</th>
              <th>Customer Name / Company</th>
              <th>Contact Details</th>
              <th>City / Location</th>
              <th>Status</th>
              <th>Owner</th>
              <th>Pipeline / Follow-Ups</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (customers && customers.length > 0) { %>
              <% customers.forEach(c => { %>
                <tr>
                  <td>
                    <span class="badge bg-light text-dark border font-monospace"><%= c.CustomerCode %></span>
                  </td>
                  <td>
                    <a href="/customers/<%= c.CustomerId %>" class="fw-bold text-primary text-decoration-none d-block">
                      <%= c.CustomerName %>
                    </a>
                    <span class="text-xs text-muted"><%= c.CompanyName || 'Independent Client' %></span>
                  </td>
                  <td class="text-sm">
                    <div><i class="bi bi-envelope text-muted me-1"></i><%= c.Email %></div>
                    <div><i class="bi bi-telephone text-muted me-1"></i><%= c.Phone %></div>
                  </td>
                  <td class="text-sm">
                    <%= c.City ? c.City + (c.State ? ', ' + c.State : '') : '-' %>
                  </td>
                  <td>
                    <span class="badge-status status-<%= c.Status.toLowerCase() %>">
                      <%= c.Status %>
                    </span>
                  </td>
                  <td class="text-sm">
                    <%= c.OwnerName || 'Unassigned' %>
                  </td>
                  <td class="text-sm">
                    <span class="badge bg-primary-subtle text-primary border me-1"><%= c.OpportunityCount %> Deals</span>
                    <span class="badge bg-secondary-subtle text-secondary border"><%= c.FollowUpCount %> Follow-ups</span>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/customers/<%= c.CustomerId %>" class="btn btn-outline-secondary" title="View 360 Details">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/customers/<%= c.CustomerId %>/edit" class="btn btn-outline-secondary" title="Edit Customer">
                        <i class="bi bi-pencil"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-5">
                  <i class="bi bi-buildings fs-1 d-block mb-2 text-secondary"></i>
                  No customers found matching the search criteria.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination Footer -->
    <% if (totalPages > 1) { %>
    <div class="crm-card-header bg-light py-2">
      <div class="text-xs text-muted">Page <%= currentPage %> of <%= totalPages %> (<%= total %> total records)</div>
      <nav aria-label="Table pagination">
        <ul class="pagination pagination-sm mb-0">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/customers?page=<%= i %>&search=<%= filters.search %>&status=<%= filters.status %>&ownerId=<%= filters.ownerId %>">
                <%= i %>
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
    <% } %>
  </div>
</div>
